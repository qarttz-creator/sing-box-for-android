<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="28dp">

        <ImageView
            android:layout_width="56dp"
            android:layout_height="80dp"
            android:layout_marginBottom="18dp"
            android:src="@drawable/ic_crystal"
            android:contentDescription="@string/app_name" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textSize="26sp"
            android:textStyle="bold"
            android:paddingBottom="6dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/activate_subtitle"
            android:textColor="@color/qartz_muted"
            android:textSize="14sp"
            android:paddingBottom="28dp" />

        <EditText
            android:id="@+id/activateInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/field_bg"
            android:textColor="@color/qartz_ink"
            android:textColorHint="@color/qartz_muted"
            android:textSize="13sp"
            android:hint="@string/activate_hint"
            android:inputType="textUri|textNoSuggestions"
            android:padding="14dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/activateButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="16dp"
            android:text="@string/activate_button"
            android:textSize="16sp"
            app:cornerRadius="28dp" />

        <ProgressBar
            android:id="@+id/activateProgress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:visibility="gone" />

    </LinearLayout>
</ScrollView>
